<Window x:Class="CodexProxySwitcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Proxy Switcher" Width="440" SizeToContent="Height" MinHeight="250" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="Codex Proxy Switcher" FontSize="22" FontWeight="SemiBold" />
    <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,22,0,0" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
    <ScrollViewer Grid.Row="2" Margin="0,8,0,0" MaxHeight="180" VerticalScrollBarVisibility="Auto">
      <TextBlock x:Name="DetailText" Foreground="#5C5C5C" TextWrapping="Wrap" />
    </ScrollViewer>
    <StackPanel x:Name="SettingsPanel" Grid.Row="3" Margin="0,18,0,0" Visibility="Collapsed">
      <TextBlock Text="本地代理地址" Margin="0,0,0,6" />
      <TextBox x:Name="ProxyUrlTextBox" Height="34" Padding="8,5" ToolTip="例如 http://127.0.0.1:7890" />
      <TextBlock Text="支持 http 或 socks5；主机必须是 localhost、127.0.0.1 或 ::1。" Margin="0,6,0,0" Foreground="#5C5C5C" FontSize="12" TextWrapping="Wrap" />
    </StackPanel>
    <StackPanel Grid.Row="4" Margin="0,22,0,0">
      <Button x:Name="PrimaryButton" Height="38" Padding="18,0" HorizontalAlignment="Left" Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0" Click="PrimaryButton_Click" Visibility="Collapsed" />
      <Button x:Name="SettingsButton" Content="代理设置" Margin="0,14,0,0" Padding="0" HorizontalAlignment="Left" Background="Transparent" Foreground="#0067C0" BorderThickness="0" Cursor="Hand" Click="SettingsButton_Click" />
    </StackPanel>
  </Grid>
</Window>
